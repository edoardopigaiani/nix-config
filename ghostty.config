# Port of the foot configuration in terminal.nix to Ghostty, with JetBrains
# Mono in place of Tamzen and the Nerd Font build behind it for the icons.
# Colours are "Ayu Classic OLED", as everywhere else; programs.foot's
# colors-dark block in terminal.nix is the reference copy of the palette and
# this is a transcription of it, slot for slot.
#
# Ghostty has no system-wide config path: it reads only
# $XDG_CONFIG_HOME/ghostty/config.ghostty and ignores XDG_CONFIG_DIRS
# (checked against 1.3.1), so the /etc/xdg mechanism foot and alacritty use
# does not exist here. terminal.nix links this file into ~/.config instead,
# the way desktop.nix does for mako. The config-file line at the end reads an
# optional ~/.config/ghostty/user.ghostty, which restores the override that
# ~/.config/foot/foot.ini gives foot.
#
# Settings equal to Ghostty's defaults are left out. Several of those
# defaults already are what foot is set to, and so need no line: copy-on-
# select, middle-click paste, Ctrl+Shift+C/V, Shift+Insert, Ctrl+0/+/-,
# Shift+Page_Up/Down, Shift+Home/End, link detection, and a discrete
# mouse-scroll-multiplier of 3 -- foot's scrollback.multiplier.

# ------------------------------------------------------------------- font
# JetBrains Mono at 9 pt, the size and face foot is on. Ghostty takes points
# and scales them by the display's scale factor, 1 here, so this is the same
# 12 px the foot block documents.
#
# Two families, in fallback order: Ghostty tries each in turn for a codepoint
# the previous one lacks.
#   - "JetBrains Mono" is the plain build, and stays primary because
#     fontconfig resolves it to the OTF (fc-match reports fontformat CFF) and
#     CFF outlines are the only kind FreeType applies stem darkening to. That
#     darkening is the macOS-like weight, and it is the other half of looking
#     like macOS besides the hinting below; FREETYPE_PROPERTIES on the wrapper
#     in terminal.nix both switches it on and sets how hard it pushes.
#     Ghostty's own font-thicken option is macOS-only (CoreText), so the env
#     var is the whole mechanism on Linux.
#   - "JetBrainsMono Nerd Font Mono" is the same face patched with the Nerd
#     Font icons, and covers what the plain build does not: the icons, braille
#     and the heavy check mark. The "Mono" cut is the one whose icons are
#     squeezed into a single cell, which is what a terminal grid wants; the
#     plain "Nerd Font" cut draws them double-width. It ships TTF only, so
#     glyphs taken from it are not stem darkened -- they are icons rather than
#     text, so the weight does not read.
# Swapping the two lines makes the icons match the text weight instead, at the
# cost of stem darkening on everything.
font-family = JetBrains Mono
font-family = JetBrainsMono Nerd Font Mono
font-size = 9

# macOS does not hint, so neither does this. foot's own config settles for
# hintslight on the belief that FreeType runs stem darkening inside light
# hinting and that hintnone would drop the darkening with it. Measured
# against FreeType 2.14.3 that turns out not to hold: rasterising the
# alphanumerics at this 12 px through the Adobe CFF engine gives 379908 units
# of ink under light hinting and 379908 under no hinting -- identical, the
# darkening fully intact either way. So the hinting can go, and glyphs keep
# the shapes they were drawn with rather than having their baselines and
# x-heights snapped to the pixel grid. Vertical placement does not move: 'H'
# and 'o' land on the same bitmap_top in both modes, so nothing shifts in the
# cell.
#
# Ghostty echoes this back as "no-hinting,...,light": it leaves the light bit
# set and adds FT_LOAD_NO_HINTING, which FreeType honours over the hinting
# target. Checked rather than assumed -- NO_HINTING alone and
# NO_HINTING|TARGET_LIGHT rasterise to the same ink to the unit.
#
# foot's antialias=true and rgba=none have no counterpart to port: Ghostty
# antialiases in greyscale and has no subpixel mode, which is what rgba=none
# selected there -- and greyscale with no subpixel AA is itself what macOS
# has done since Mojave.
freetype-load-flags = no-hinting

# foot's gamma-correct-blending = no. `native` blends in sRGB directly, which
# keeps light text on black as full as macOS renders it; Ghostty's default on
# Linux is linear-corrected, which is gamma-correct blending with a
# compensation pass.
alpha-blending = native

# foot's bold-text-in-bright = palette-based: bold text on one of the regular
# colours moves to that colour's bright entry. Under Ayu Classic all eight
# bright slots are measurably lighter than their regular twin, so this shifts
# colour throughout rather than only for black. `bold-color = bright` is the
# current spelling; bold-is-bright is deprecated.
bold-color = bright

# ----------------------------------------------------------------- window
# foot's pad = "10x10 center". The padding is in points and DPI-scaled, 1:1
# at this display's scale, and `balance` is the "center" half: it spreads the
# leftover sub-cell remainder across all four edges instead of letting the
# top-left cell hug the corner.
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

# foot's initial-window-mode = maximized.
maximize = true

# foot's csd.preferred = none. niri offers no server-side decorations, so
# without this Ghostty draws a GTK title bar of its own.
window-decoration = none

# foot's cursor.blink = no. Explicitly false rather than left blank: blank
# leaves DEC mode 12 in charge of blinking, false pins it off. DECSCUSR can
# still change it, as it can in foot.
cursor-style-blink = false

# foot's bell.system = no, and alacritty's zero-duration bell before that:
# the bell does nothing. Ghostty's default is already no-system and no-audio,
# but it raises the window's attention hint and marks the title, so those are
# turned off too -- otherwise a bell in a background window lights it up in
# waybar's window list.
bell-features = no-system,no-audio,no-attention,no-title,no-border

# foot's scrollback.lines = 10000 has no direct equivalent: Ghostty sizes the
# buffer in bytes, not lines, and the two cannot be converted without fixing
# a width. The 10 MB default is left alone -- at this window's width it holds
# the same order of lines, it is per surface, and it is allocated lazily.

# --------------------------------------------------------------- keybinds
# foot's Shift+Alt+U / Shift+Alt+D, on top of Ghostty's defaults.
# Shift+Page_Up and Shift+Page_Down are already bound; their keypad twins,
# which foot's binding also lists, are not, so they are added here.
keybind = alt+shift+u=scroll_page_up
keybind = alt+shift+d=scroll_page_down
keybind = shift+numpad_page_up=scroll_page_up
keybind = shift+numpad_page_down=scroll_page_down

# Not ported: foot's show-urls-launch (Ctrl+Shift+O, and alacritty's
# Ctrl+Shift+H before it). Ghostty has no hint mode -- nothing that labels
# every URL on screen for the keyboard to pick -- so there is no action to
# bind. link-url is on by default, so URLs are still detected, Ctrl+Click
# opens them, and the command palette carries "Copy URL to Clipboard".
# foot's jump-labels colours go with it, having nothing left to colour.
#
# Mind that Ctrl+Shift+O is not merely unbound here: Ghostty ships it as
# new_split:right, so the muscle memory from foot opens a split instead.
# Ctrl+Shift+E is the other half of that pair (new_split:down).

# ----------------------------------------------------------------- colors
# Zed's "Ayu Classic OLED", the same values programs.foot's colors-dark sets.
# That block is where each one is justified -- why regular0 follows the
# background rather than the theme's own ansi black, why bright0 is lifted to
# 3.77:1, where the selection blend comes from; this file does not repeat it.
background = #000000
foreground = #d9d7d0

# foot writes `cursor = 000000 e6b450`, text colour first: black on the amber
# accent, which keeps the character under the block readable where a cursor
# the colour of the foreground would not.
cursor-color = #e6b450
cursor-text = #000000

selection-foreground = #d9d7d0
selection-background = #152e3d

# foot's search-box-match / search-box-no-match do not map across: foot
# colours the search box, Ghostty colours the matches in the grid. The
# currently selected match takes the amber that foot's search-box-match
# carried -- the theme's own search.active_match_background -- and the other
# matches take the selection colours, so they read as found but not current.
# There is no no-match colour to set; Ghostty simply finds nothing.
search-foreground = #d9d7d0
search-background = #152e3d
search-selected-foreground = #000000
search-selected-background = #e6b450

palette = 0=#000000
palette = 1=#ea6c73
palette = 2=#91b362
palette = 3=#f9af4f
palette = 4=#53bdfa
palette = 5=#d2a6ff
palette = 6=#90e1c6
palette = 7=#c7c7c7
palette = 8=#686868
palette = 9=#f07178
palette = 10=#c2d94c
palette = 11=#e8c783
palette = 12=#59c2ff
palette = 13=#ddbcff
palette = 14=#95e6cb
palette = 15=#ffffff

# The strip grey, redefined on entry 235 exactly as colors-dark does it:
# weechat draws its title and status bars on a palette index (weechat.conf
# takes no hex), and darkblue.micro reads the same entry for micro's
# cursor-line and inactive statusline, so both move off the xterm default of
# #262626 together.
palette = 235=#1b1f29

# Not ported, for want of an option: foot's dim0-7, the theme's own
# terminal.ansi.dim_* set for SGR 2 -- Ghostty always derives faint text by
# blending the current colour, so the palette cannot supply it; foot's
# scrollback-indicator, which Ghostty has no counterpart for; and `urls`,
# since Ghostty underlines a hovered link rather than recolouring it.

# ------------------------------------------------------------------- misc
# TERM is left at Ghostty's own xterm-ghostty, so foot's `term = foot` needs
# no counterpart: the package ships that terminfo entry and terminal.nix puts
# it on TERMINFO_DIRS. Unlike foot's, it is not in ncurses, so sshing to a
# host that lacks it wants `infocmp -x xterm-ghostty | ssh HOST tic -x -`
# once -- or TERM=xterm-256color for that session.

# Read last and so able to override anything above, which is the role
# ~/.config/foot/foot.ini plays for foot. `?` makes a missing file not an
# error, and Ghostty expands the `~` itself. Note the ordering rule that
# makes this work: an included file always takes effect after the file that
# included it, wherever the config-file line happens to sit.
config-file = ?~/.config/ghostty/user.ghostty
